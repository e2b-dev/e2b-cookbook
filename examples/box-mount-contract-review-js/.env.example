# https://e2b.dev/dashboard
E2B_API_KEY=

# Box Developer Console > your app > Configuration > Developer Token
# Expires 60 minutes after you create it: generate it last, right before npm run doctor
BOX_ACCESS_TOKEN=
# The number at the end of an empty Box folder's URL: https://app.box.com/folder/<id>
BOX_FOLDER_ID=

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional, defaults to claude-haiku-4-5-20251001
CLAUDE_MODEL=
