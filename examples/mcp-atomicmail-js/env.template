# E2B API Key
# Get your API key from: https://e2b.dev/docs/getting-started/api-key
E2B_API_KEY=e2b_your_api_key_here

# Optional: desired inbox username (5–21 chars, local part of @atomicmail.ai).
# If unset, a random username like "e2b-agent-k3f9zq" is generated per run.
# ATOMIC_MAIL_USERNAME=my-agent

# Optional: send the demo email to this address instead of the agent's own inbox.
# When set, the example only sends (it cannot read someone else's mailbox).
# RECIPIENT_EMAIL=you@example.com

# Note: Atomic Mail needs no API key — the agent registers its own inbox
# inside the sandbox via a proof-of-work challenge (no human, no CAPTCHA).
