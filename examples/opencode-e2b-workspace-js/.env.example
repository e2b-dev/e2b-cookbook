# Required: the plugin provisions E2B sandboxes with this key.
E2B_API_KEY=e2b_your_api_key

# Optional: model for the prompts, as provider/model. When unset, the first provider
# you are logged into with `opencode auth login` is used. Log in with `opencode auth login`
# (not an env var): OpenCode forwards stored credentials into the sandbox, env vars stay local.
# OPENCODE_MODEL=openai/gpt-5.6-luna

# Optional: where to load the plugin from. Defaults to the npm package.
# Point it at a local build while developing the plugin itself.
# OPENCODE_E2B_PLUGIN=/absolute/path/to/opencode-e2b/dist/index.js
