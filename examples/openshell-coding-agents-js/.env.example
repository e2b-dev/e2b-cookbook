# E2B key for the offline grader sandboxes (and the one openshell-e2b uses).
E2B_API_KEY=
# Model keys. They go into OpenShell providers on the gateway, never into the sandboxes.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Your openshell-e2b checkout, with `npm run connect` running (see README).
OPENSHELL_E2B_DIR=
